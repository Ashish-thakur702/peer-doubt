{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": [
    "types/next-auth.d.ts",
    "src/lib/auth/roles.d.mts",
    "src/lib/auth/roles.mjs",
    "src/lib/auth/policy.mjs",
    "src/lib/auth/public-registration.mjs",
    "src/lib/auth/scope.mjs",
    "src/lib/auth/scope-policy.mjs",
    "src/lib/courses.js"
  ],
  "exclude": ["node_modules"]
}
